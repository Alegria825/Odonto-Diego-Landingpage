---
// La foto se busca por "id" en src/assets/images/tratamientos/<id>.jpg
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { item } = Astro.props;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/images/tratamientos/*.{jpg,jpeg,png,webp}', { eager: true });
const foto = Object.entries(fotos).find(([ruta]) => ruta.includes(`/${item.id}.`))?.[1].default;
---
<article class="card rv">
  <div class="ph">
    {foto && <Image src={foto} alt={item.nombre} width={640} height={640} quality={75} format="webp" loading="lazy" />}
  </div>
  <div class="cb">
    <h3>{item.nombre}</h3>
    <p>{item.texto}</p>
  </div>
</article>
