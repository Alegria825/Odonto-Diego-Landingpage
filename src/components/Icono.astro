---
// Íconos de línea. Nombres: search | tooth | shield | drop
const { nombre } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'search' && (<><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></>)}
  {nombre === 'tooth' && (<path d="M7 3C4.5 3 3 5 3 7.5c0 2 1 3.3 1.5 5.5S5.2 21 7 21c2 0 1.5-5 3-5h4c1.5 0 1 5 3 5s2.5-6 3-8.5c.5-2.2 1.500-3.5 1.5-5.500C21 5 19.500 3 17 3c-2 0-2.500 1-5 1S9 3 7 3z" />)}
  {nombre === 'shield' && (<><path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.500 7-10V6z" /><path d="m9 12 2 2 4-4" /></>)}
  {nombre === 'drop' && <path d="M12 3c3 4 5 6.5 5 9.500a5 5 0 0 1-10 0C7 9.500 9 7 12 3z" />}
</svg>
